program ::= { statement } finish

primitive_type ::= "i32" | "i64" | "bool"

struct_type    ::= ident

type           ::= primitive_type | struct_type

struct_def ::= "struct" ident NL "{" NL { field_decl } "}" NL

field_decl ::= type [ "mut" ] ident NL

declaration ::= type [ "mut" ] ident "{" expr { "," expr } "}"

assignment ::= ident ":=" expr

finish ::= "exit" operand

statement ::= struct_def | declaration | assignment

operand ::= ident | number | "true" | "false"

expr ::= arith [ ("==" | "!=") arith ]

arith ::= term { ("+" | "-") term }

term ::= operand { "*" operand }


