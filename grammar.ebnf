program ::= { struct_def } { fn_decl } { statement } finish

primitive_type ::= "i32" | "i64" | "bool"

struct_type ::= ident

type ::= primitive_type | struct_type

struct_def ::= "struct" ident NL "{" NL { field_decl } "}" NL

field_decl ::= type [ "mut" ] ident NL

fn_decl ::= "fn" ident ":=" "(" [ param_list ] ")" "->" type NL block

param_list ::= param { "," param }

param ::= type ident

fn_call ::= ident "(" [ arg_list ] ")"

arg_list ::= expr { "," expr }

declaration ::= type [ "mut" ] ident "{" init_expr { "," init_expr } "}"

init_expr ::= expr | "{" init_expr { "," init_expr } "}"

field ::= ident "." ident { "." ident }

target ::= ident [ "." ident { "." ident } ]

assignment ::= target ":=" expr

if ::= "if" expr NL block [ "else" NL block ]

while ::= "while" expr NL block

block ::= "{" NL { statement } [ finish NL ] "}" NL

finish ::= "exit" factor

statement ::= declaration | assignment | if | while

operand ::= fn_call | ident | number | "true" | "false" | "!" operand

factor ::= operand | field

expr ::= arith [ ("==" | "!=") arith ]

arith ::= term { ("+" | "-") term }

term ::= factor { "*" factor }
